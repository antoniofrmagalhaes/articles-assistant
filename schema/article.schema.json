    },
    "_type": {
      "const": "article"
    },
    "_key": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "title",
    "frontMatter",
    "sections",
    "footnotes",
    "author",
    "hero",
    "seo",
    "taxonomy",
    "publication",
    "slug",
    "_type"
